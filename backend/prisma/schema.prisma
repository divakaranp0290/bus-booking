generator client {
  provider = "prisma-client"
  output   = "../src/generated" // ⬅️ will create src/generated/client.*
}

datasource db {
  provider = "postgresql"
}

// -------------------------------
// MODELS
// -------------------------------

model User {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  name      String?
  createdAt DateTime @default(now())

  bookings Booking[]
}

model Bus {
  id          Int      @id @default(autoincrement())
  externalId  String   @unique
  operator    String
  fromCity    String
  toCity      String
  depTime     DateTime
  arrTime     DateTime
  durationMin Int
  baseFare    Int

  seats    Seat[]
  bookings Booking[]
}

model Seat {
  id        Int     @id @default(autoincrement())
  seatCode  String
  row       Int
  col       Int
  price     Int
  available Boolean @default(true)

  busId Int
  bus   Bus @relation(fields: [busId], references: [id])

  @@unique([busId, seatCode])
}

model Booking {
  id          Int      @id @default(autoincrement())
  pnr         String   @unique
  busId       Int
  userId      Int?
  seats       String
  totalAmount Int
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])
  bus  Bus   @relation(fields: [busId], references: [id])

  @@index([busId])
  @@index([status])
}
